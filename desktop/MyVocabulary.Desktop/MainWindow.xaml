<Window x:Class="MyVocabulary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="My Vocabulary / 我的词汇本"
        Icon="Assets/app-icon-v5.ico"
        Width="1180"
        Height="820"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7FBF4"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Grid ClipToBounds="True">
    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

    <Border x:Name="LoadingOverlay" Background="#F7FBF4">
      <Grid>
        <Canvas IsHitTestVisible="False" Opacity="0.72">
          <Ellipse Width="360" Height="360" Canvas.Left="-120" Canvas.Top="-170" Fill="#E8F8DC">
            <Ellipse.RenderTransform>
              <TranslateTransform x:Name="TopBlobTranslate" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="290" Height="290" Canvas.Right="-90" Canvas.Bottom="-120" Fill="#E7F6FF">
            <Ellipse.RenderTransform>
              <TranslateTransform x:Name="BottomBlobTranslate" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="16" Height="16" Canvas.Left="140" Canvas.Bottom="150" Fill="#F5C637" Opacity="0.72" />
          <Ellipse Width="10" Height="10" Canvas.Right="185" Canvas.Top="145" Fill="#58CC02" Opacity="0.55" />
        </Canvas>

        <Grid x:Name="LoadingContent" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="LoadingContentTranslate" />
          </Grid.RenderTransform>
          <StackPanel Width="520" HorizontalAlignment="Center">
            <Grid Width="118" Height="118" HorizontalAlignment="Center" Margin="0,0,0,22">
              <Ellipse x:Name="LogoHalo" Width="112" Height="112" Fill="#DFF5D2" Opacity="0.72"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="LogoHaloScale" ScaleX="0.9" ScaleY="0.9" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Border x:Name="LogoShell" Width="94" Height="94" Padding="7" CornerRadius="28"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFF"
                      RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="28" ShadowDepth="9" Direction="270" Color="#366E2A" Opacity="0.18" />
                </Border.Effect>
                <Border.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.84" ScaleY="0.84" />
                    <TranslateTransform x:Name="LogoTranslate" Y="12" />
                  </TransformGroup>
                </Border.RenderTransform>
                <Image Source="Assets/app-icon-256.png" Width="80" Height="80" Stretch="Uniform" />
              </Border>
              <Border Width="29" Height="29" CornerRadius="15" Background="#F5C637"
                      BorderBrush="#FFFFFF" BorderThickness="3" HorizontalAlignment="Right"
                      VerticalAlignment="Top" Margin="0,3,3,0">
                <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="13" FontWeight="Bold"
                           Foreground="#765500" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>

            <TextBlock Text="我的词汇本" FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                       FontSize="29" FontWeight="SemiBold" Foreground="#2F3A40"
                       HorizontalAlignment="Center" />
            <TextBlock Text="M Y   V O C A B U L A R Y" FontFamily="Segoe UI Semibold" FontSize="10"
                       FontWeight="SemiBold" Foreground="#58A82E"
                       HorizontalAlignment="Center" Margin="0,5,0,22" />

            <Grid Height="34">
              <StackPanel x:Name="RotatingPhrasePanel" Orientation="Horizontal"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="StatusText" Text="正在准备本地学习空间…"
                       FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                       FontSize="13" Foreground="#718078" TextAlignment="Center"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
              <Ellipse x:Name="DotOne" Width="7" Height="7" Fill="#58CC02" Opacity="0.35" Margin="4,0" />
              <Ellipse x:Name="DotTwo" Width="7" Height="7" Fill="#58CC02" Opacity="0.35" Margin="4,0" />
              <Ellipse x:Name="DotThree" Width="7" Height="7" Fill="#58CC02" Opacity="0.35" Margin="4,0" />
            </StackPanel>

            <Border Height="1" Width="110" Background="#DDE8D8" HorizontalAlignment="Center" Margin="0,26,0,13" />
            <TextBlock Text="本地词库  ·  自在学习" FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="11" FontWeight="SemiBold" Foreground="#91A096"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
